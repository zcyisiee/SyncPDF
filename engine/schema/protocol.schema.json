{
  "$defs": {
    "BlockAlign": {
      "description": "段落对齐。",
      "enum": [
        "left",
        "center",
        "right",
        "justify"
      ],
      "type": "string"
    },
    "BlockEditState": {
      "description": "一段的覆盖状态（`block_edits` 事件）。",
      "properties": {
        "manual": {
          "description": "译文为手改（不是模型译文）。",
          "type": "boolean"
        },
        "paragraph_id": {
          "$ref": "#/$defs/ParagraphIdSchema"
        },
        "style": {
          "$ref": "#/$defs/BlockStyle",
          "default": {}
        }
      },
      "required": [
        "paragraph_id",
        "manual"
      ],
      "type": "object"
    },
    "BlockStyle": {
      "description": "单块排版覆盖；字段为 `None` 时沿用整篇设置 / 原文判定。",
      "properties": {
        "align": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockAlign"
            },
            {
              "type": "null"
            }
          ]
        },
        "font_family": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontFamily"
            },
            {
              "type": "null"
            }
          ]
        },
        "font_scale": {
          "description": "译文字号相对原文的倍数。",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "line_height": {
          "description": "行距（字号的倍数）。",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CoordSystemSchema": {
      "description": "镜像 `syncpdf_core::CoordSystem` 的 JSON 形态。",
      "enum": [
        "pdf_user",
        "image_top_left"
      ],
      "type": "string"
    },
    "Event": {
      "description": "stdout 事件（不含 `seq`/`ts` 信封字段）。",
      "oneOf": [
        {
          "description": "任务开始。",
          "properties": {
            "doc_id": {
              "type": "string"
            },
            "engine_version": {
              "type": "string"
            },
            "pages": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "protocol_version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "run_started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "protocol_version",
            "engine_version",
            "doc_id",
            "pages"
          ],
          "type": "object"
        },
        {
          "description": "阶段开始。",
          "properties": {
            "stage": {
              "$ref": "#/$defs/Stage"
            },
            "type": {
              "const": "stage_started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "stage"
          ],
          "type": "object"
        },
        {
          "description": "阶段结束（`elapsed_ms` 为该阶段耗时）。",
          "properties": {
            "elapsed_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stage": {
              "$ref": "#/$defs/Stage"
            },
            "type": {
              "const": "stage_finished",
              "type": "string"
            }
          },
          "required": [
            "type",
            "stage",
            "elapsed_ms"
          ],
          "type": "object"
        },
        {
          "description": "进度（不编造 ETA）。",
          "properties": {
            "done": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "stage": {
              "$ref": "#/$defs/Stage"
            },
            "total": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "progress",
              "type": "string"
            }
          },
          "required": [
            "type",
            "stage",
            "done",
            "total"
          ],
          "type": "object"
        },
        {
          "description": "一页的版面区域（layout_analysis 之后按页发出，页号 1 基）。",
          "properties": {
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "regions": {
              "items": {
                "$ref": "#/$defs/LayoutRegion"
              },
              "type": "array"
            },
            "type": {
              "const": "layout",
              "type": "string"
            }
          },
          "required": [
            "type",
            "page",
            "regions"
          ],
          "type": "object"
        },
        {
          "description": "文档元数据：首页 Title 段落与作者行；识别不到为 `None`。",
          "properties": {
            "authors": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "doc_meta",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "本篇生效的单块覆盖（每次 run 应用前整表发一次，空表也发）。",
          "properties": {
            "edits": {
              "items": {
                "$ref": "#/$defs/BlockEditState"
              },
              "type": "array"
            },
            "type": {
              "const": "block_edits",
              "type": "string"
            }
          },
          "required": [
            "type",
            "edits"
          ],
          "type": "object"
        },
        {
          "description": "段落状态更新。",
          "properties": {
            "boxes": {
              "description": "`None` = 未识别；`Some([])` = 识别了但无框（规约 #12/#13）。",
              "items": {
                "$ref": "#/$defs/RectSchema"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "coord_system": {
              "$ref": "#/$defs/CoordSystemSchema"
            },
            "kind": {
              "$ref": "#/$defs/RegionKindSchema",
              "description": "段落所在区域类别。"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "paragraph_id": {
              "$ref": "#/$defs/ParagraphIdSchema"
            },
            "source_bbox": {
              "$ref": "#/$defs/RectSchema",
              "description": "源段落外接框（原文侧几何；`boxes` 在译文发布后是译文行框）。"
            },
            "source_text": {
              "description": "源文本（阅读顺序）。",
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/ParagraphStatusSchema"
            },
            "translated_html": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "paragraph",
              "type": "string"
            }
          },
          "required": [
            "type",
            "paragraph_id",
            "page",
            "status",
            "coord_system",
            "kind",
            "source_text",
            "source_bbox"
          ],
          "type": "object"
        },
        {
          "description": "一页完成（可选增量预览）。",
          "properties": {
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "preview_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "page_ready",
              "type": "string"
            }
          },
          "required": [
            "type",
            "page",
            "revision"
          ],
          "type": "object"
        },
        {
          "description": "问题报告。",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "page": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "paragraph_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ParagraphIdSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "severity": {
              "$ref": "#/$defs/Severity"
            },
            "type": {
              "const": "issue",
              "type": "string"
            }
          },
          "required": [
            "type",
            "severity",
            "code",
            "message"
          ],
          "type": "object"
        },
        {
          "description": "文档完成。",
          "properties": {
            "output": {
              "type": "string"
            },
            "stats": {
              "$ref": "#/$defs/Stats"
            },
            "type": {
              "const": "document_finished",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output",
            "stats"
          ],
          "type": "object"
        },
        {
          "description": "任务结束。",
          "properties": {
            "elapsed_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "ok": {
              "type": "boolean"
            },
            "type": {
              "const": "run_finished",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ok",
            "elapsed_ms"
          ],
          "type": "object"
        },
        {
          "description": "错误（`fatal` = 任务无法继续）。",
          "properties": {
            "code": {
              "type": "string"
            },
            "fatal": {
              "type": "boolean"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fatal",
            "code",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "FontFamily": {
      "description": "字体族：衬线（宋体类）/ 无衬线（黑体类）。",
      "enum": [
        "serif",
        "sans"
      ],
      "type": "string"
    },
    "LayoutRegion": {
      "description": "版面区域（`layout` 事件）。坐标为 PDF 用户空间。",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/RectSchema"
        },
        "inline": {
          "description": "公式区域落在可译区域内（行内公式，作为 KEEP 原子随正文移动）。",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/RegionKindSchema"
        }
      },
      "required": [
        "kind",
        "inline",
        "bbox"
      ],
      "type": "object"
    },
    "Mode": {
      "description": "输出模式：整页替换或双语对照。",
      "oneOf": [
        {
          "const": "full",
          "description": "整页替换（默认）。",
          "type": "string"
        },
        {
          "const": "bilingual",
          "description": "双语对照。",
          "type": "string"
        }
      ]
    },
    "ParagraphIdSchema": {
      "description": "镜像 `syncpdf_core::ParagraphId` 的 JSON 形态（字符串，`P{page:02}-{seq:03}`）。",
      "type": "string"
    },
    "ParagraphStatusSchema": {
      "description": "镜像 `syncpdf_core::ir::ParagraphStatus` 的 JSON 形态。",
      "enum": [
        "pending",
        "translated",
        "typeset",
        "not_replaced",
        "fallback"
      ],
      "type": "string"
    },
    "RectSchema": {
      "description": "镜像 `syncpdf_core::Rect` 的 JSON 形态。",
      "properties": {
        "x0": {
          "format": "float",
          "type": "number"
        },
        "x1": {
          "format": "float",
          "type": "number"
        },
        "y0": {
          "format": "float",
          "type": "number"
        },
        "y1": {
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "type": "object"
    },
    "RegionKindSchema": {
      "description": "镜像 `syncpdf_core::ir::RegionKind` 的 JSON 形态。",
      "enum": [
        "text",
        "title",
        "paragraph_title",
        "list",
        "caption",
        "table",
        "figure",
        "formula",
        "header",
        "footer",
        "foot_note",
        "reference",
        "code",
        "abstract",
        "other"
      ],
      "type": "string"
    },
    "Request": {
      "description": "stdin 请求。首条必须是 `Configure`；`Run` 启动任务；其余作用于当前文档。",
      "oneOf": [
        {
          "description": "全局配置（首条；api_key 只在此出现）。",
          "properties": {
            "api_key": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Secret"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "cache_dir": {
              "type": "string"
            },
            "concurrency": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "$ref": "#/$defs/TranslateProvider",
              "description": "LLM 通道（http / pi）；决定 `translator` 字段里哪个分支生效。"
            },
            "translator": {
              "$ref": "#/$defs/TranslatorKind"
            },
            "type": {
              "const": "configure",
              "type": "string"
            }
          },
          "required": [
            "type",
            "provider",
            "model",
            "concurrency",
            "cache_dir",
            "translator"
          ],
          "type": "object"
        },
        {
          "description": "启动翻译任务。",
          "properties": {
            "doc_id": {
              "type": "string"
            },
            "font_profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "input": {
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/Mode"
            },
            "output": {
              "type": "string"
            },
            "pages": {
              "description": "1 基页号子集；`None` = 全部页。",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "source_lang": {
              "type": "string"
            },
            "store": {
              "description": "本篇阶段缓存库路径（桌面端：`~/.sp/docs/<id>/store.db`）；`None` = 引擎默认的共享临时库。",
              "type": [
                "string",
                "null"
              ]
            },
            "target_lang": {
              "type": "string"
            },
            "terminology": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "type",
            "doc_id",
            "input",
            "output",
            "source_lang",
            "target_lang",
            "mode"
          ],
          "type": "object"
        },
        {
          "description": "标记段落待重译：清掉手改译文，下一次 `run` 对这些段绕过翻译缓存。\n只写本篇库，不自己跑；调用方随后排一次 `run`。",
          "properties": {
            "doc_id": {
              "type": "string"
            },
            "paragraph_ids": {
              "items": {
                "$ref": "#/$defs/ParagraphIdSchema"
              },
              "type": "array"
            },
            "store": {
              "description": "与 `run.store` 相同的本篇库；`None` = 引擎默认的共享临时库。",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "retranslate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "doc_id",
            "paragraph_ids"
          ],
          "type": "object"
        },
        {
          "description": "保存单段覆盖（手改译文 + 单块排版），整体替换该段已有覆盖。\n只写本篇库，不自己跑；调用方随后排一次 `run`（其余段全走缓存）。",
          "properties": {
            "doc_id": {
              "type": "string"
            },
            "paragraph_id": {
              "$ref": "#/$defs/ParagraphIdSchema"
            },
            "store": {
              "description": "与 `run.store` 相同的本篇库；`None` = 引擎默认的共享临时库。",
              "type": [
                "string",
                "null"
              ]
            },
            "style": {
              "$ref": "#/$defs/BlockStyle",
              "default": {}
            },
            "translated_html": {
              "description": "手改译文（受限 HTML，同 `paragraph.translated_html`）；`None` = 用模型译文。",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "apply_edit",
              "type": "string"
            }
          },
          "required": [
            "type",
            "doc_id",
            "paragraph_id"
          ],
          "type": "object"
        },
        {
          "description": "发布。",
          "properties": {
            "doc_id": {
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/Mode"
            },
            "output": {
              "type": "string"
            },
            "type": {
              "const": "export",
              "type": "string"
            }
          },
          "required": [
            "type",
            "doc_id",
            "output",
            "mode"
          ],
          "type": "object"
        },
        {
          "description": "取消当前任务。",
          "properties": {
            "type": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Secret": {
      "description": "不落日志、不进 argv 的密钥。`Debug`/`Display` 打码为 `***`；serde 按普通字符串。",
      "type": "string"
    },
    "Severity": {
      "description": "issue 严重级别。",
      "oneOf": [
        {
          "const": "info",
          "description": "提示性信息（不影响产物）。",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "可恢复问题（回退 / 降级已发生）。",
          "type": "string"
        },
        {
          "const": "error",
          "description": "阻断该段或该页的问题。",
          "type": "string"
        }
      ]
    },
    "Stage": {
      "description": "处理阶段名（snake_case，与 hjfy 事件语义一致）。",
      "enum": [
        "preflight",
        "source_analysis",
        "layout_analysis",
        "paragraph_analysis",
        "translating",
        "typesetting",
        "validating",
        "publishing"
      ],
      "type": "string"
    },
    "Stats": {
      "description": "`document_finished` 的统计（§9.3：字体数、膨胀比、fallback 数）。",
      "properties": {
        "expansion_ratio": {
          "description": "输出 / 输入字节数之比。",
          "format": "double",
          "type": "number"
        },
        "fallbacks": {
          "description": "回退原文的段落数。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fonts": {
          "description": "嵌入的目标字体数。",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "fonts",
        "expansion_ratio",
        "fallbacks"
      ],
      "type": "object"
    },
    "TranslateProvider": {
      "description": "LLM 提供方。当前三种通道：OpenAI 兼容 HTTP、pi CLI、agy CLI（均为本地子进程）。",
      "oneOf": [
        {
          "const": "http",
          "description": "OpenAI 兼容端点（`base_url` + `model`），经 `TranslatorKind::Http`。",
          "type": "string"
        },
        {
          "const": "pi",
          "description": "pi CLI 子进程（`TranslatorKind::Pi`）。",
          "type": "string"
        },
        {
          "const": "agy",
          "description": "agy CLI 子进程（`TranslatorKind::Agy`）。",
          "type": "string"
        }
      ]
    },
    "TranslatorKind": {
      "description": "翻译器配置（`configure` 请求的 `translator` 字段）。",
      "oneOf": [
        {
          "description": "pi CLI：`program` 可执行路径（默认 `pi`）、模型、thinking 档位。",
          "properties": {
            "kind": {
              "const": "pi",
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "program": {
              "type": "string"
            },
            "thinking": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "program",
            "model",
            "thinking"
          ],
          "type": "object"
        },
        {
          "description": "agy CLI：print + stream-json；`program` 可执行路径（默认 `agy`）、模型。",
          "properties": {
            "kind": {
              "const": "agy",
              "type": "string"
            },
            "model": {
              "description": "模型名本身已带档位（如 `gemini-3.8-flash-low`）。",
              "type": "string"
            },
            "program": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "program",
            "model"
          ],
          "type": "object"
        },
        {
